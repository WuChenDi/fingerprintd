/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ENV LIMIT: there is no CF account / `wrangler login` in this environment and
  // Durable Objects + D1 are paid, so only LOCAL execution is wired here
  // (`wrangler dev --local`, `wrangler deploy --dry-run`, and the miniflare-backed
  // vitest state suite). A real remote deploy is deferred to a human with an
  // account — see README "Environment limit". The `database_id` below is a
  // placeholder; a real deploy replaces it with the id from `wrangler d1 create`.
  "name": "fingerprintd-edge",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,
  // Non-secret defaults for local dev. Real secrets (FP_SALT_SECRET, FP_PROBE_KEY,
  // FP_SIGNING_KEY) are set with `wrangler secret put <NAME>` / `.dev.vars`, never
  // committed. With none set the Worker mirrors a default `fingerprintd`: probe
  // off, signing off, timestamp window off, 30s nonce TTL.
  "vars": {
    "FP_NONCE_TTL_SECS": "30",
    "FP_TS_SKEW_SECS": "30"
  },
  // One-time nonce store (PCF4): a Durable Object gives the atomic check-and-burn
  // that D1/KV eventual consistency cannot. Bound as `env.NONCE`.
  "durable_objects": {
    "bindings": [
      {
        "name": "NONCE",
        "class_name": "NonceDurableObject"
      }
    ]
  },
  // SQLite-backed Durable Object storage for the nonce class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NonceDurableObject"]
    }
  ],
  // Fingerprint library + blocking inverted index (PCF4), bound as `env.DB`.
  // Migrations live in ./src/database (drizzle-kit generate; applied with `wrangler d1 migrations apply`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fingerprintd",
      "database_id": "local-fingerprintd",
      "migrations_dir": "src/database"
    }
  ]
}
