/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // fingerprintd edge Worker. Runs with no account locally (`wrangler dev
  // --local`, the miniflare-backed vitest suite) and deploys to Cloudflare via
  // `.github/workflows/deploy-edge.yml` (or `bun run deploy`). SQLite-backed
  // Durable Objects + D1 are on the Workers free plan. `database_id` below is a
  // real D1 (from `wrangler d1 create fingerprintd`); the runtime secrets
  // (FP_SALT_SECRET / FP_PROBE_KEY / FP_SIGNING_KEY) are Worker Secrets, never
  // committed — set via `wrangler secret put` or the deploy workflow's sync.
  "name": "fingerprintd-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  // Non-secret defaults for local dev. Real secrets (FP_SALT_SECRET, FP_PROBE_KEY,
  // FP_SIGNING_KEY) are set with `wrangler secret put <NAME>` / `.dev.vars`, never
  // committed. With none set the Worker mirrors a default `fingerprintd`: probe
  // off, signing off, timestamp window off, 30s nonce TTL.
  "vars": {
    "FP_NONCE_TTL_SECS": "30",
    "FP_TS_SKEW_SECS": "30",
    // Allowed browser CORS origins (comma-separated; `*` = any). Set to the web
    // playground deployment so it can call /challenge and /identify cross-origin.
    "FP_CORS_ORIGINS": "https://fingerprintd.pages.dev",
    // Check-in retention is off by default: set CHECKIN_RETENTION_SECS > 0 to have
    // the scheduled cron purge old check-in events from CHECKIN_DB.
    "CHECKIN_RETENTION_SECS": "0"
  },
  // Durable Objects: the one-time nonce store (atomic check-and-burn `env.NONCE`)
  // and the hot check-in velocity counters (`env.VELOCITY`), each SQLite-backed.
  "durable_objects": {
    "bindings": [
      {
        "name": "NONCE",
        "class_name": "NonceDurableObject"
      },
      {
        "name": "VELOCITY",
        "class_name": "VelocityDurableObject"
      }
    ]
  },
  // SQLite-backed Durable Object storage. v1 for the nonce class; v2 adds the
  // check-in velocity class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NonceDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["VelocityDurableObject"]
    }
  ],
  // Two SEPARATE D1 databases:
  //   - `env.DB`         — fingerprint library + blocking index (src/database).
  //   - `env.CHECKIN_DB` — check-in event log (src/checkin-database). Its
  //     database_id is a placeholder; a real D1 is provisioned by a human.
  // Migrations are generated with drizzle-kit and applied with
  // `wrangler d1 migrations apply`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fingerprintd",
      "migrations_dir": "src/database",
      "database_id": "af4a17c8-0884-462b-9f86-6289eaddd21c"
    },
    {
      "binding": "CHECKIN_DB",
      "database_name": "checkin-risk",
      "migrations_dir": "src/checkin-database",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // D1 retention purge: the `scheduled` handler in src/index.ts runs daily
  // at 03:00 UTC, deleting templates older than FP_RETENTION_SECS (0/unset ⇒
  // no-op). Set FP_RETENTION_SECS in [vars] to enable retention.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
