{
  "name": "@fingerprintd/client",
  "version": "0.0.0",
  "description": "Browser SDK for the fingerprintd challenge/identify flow (collect-only; the server judges).",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "@fingerprintjs/fingerprintjs": "^5"
  }
}
