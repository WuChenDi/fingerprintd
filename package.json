{
  "name": "fingerprintd",
  "version": "0.0.0",
  "description": "Server-side device fingerprinting: Rust cargo workspace (server + fp-core + fp-wasm) plus a Bun workspace for the TS packages.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.2",
      "@types/node": "^26.1.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.10",
      "wrangler": "^4.107.0"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "verify:edge": "bun scripts/verify-deploy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
