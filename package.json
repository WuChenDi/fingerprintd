{
  "name": "fingerprintd",
  "version": "0.0.0",
  "description": "Server-side device fingerprinting: Rust cargo workspace (server + fp-core + fp-wasm) plus a Bun workspace for the TS packages.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "fingerprinting",
    "anti-fraud",
    "device-fingerprint",
    "bot-detection",
    "security"
  ],
  "homepage": "https://github.com/WuChenDi/fingerprintd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuChenDi/fingerprintd.git"
  },
  "bugs": {
    "url": "https://github.com/WuChenDi/fingerprintd/issues"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@fingerprintjs/fingerprintjs": "^5",
      "@types/node": "^26.1.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.10",
      "wrangler": "^4.107.0"
    }
  },
  "scripts": {
    "dev": "bun run --filter=./apps/* dev",
    "dev:web": "bun run --filter '@cdlab/fingerprintd-web' dev",
    "dev:edge": "bun run --filter '@cdlab/fingerprintd-edge' dev",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "clean": "bash scripts/clean.sh",
    "verify:edge": "bun scripts/verify-deploy.ts",
    "prepare": "bun run --filter=./packages/* build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2"
  }
}
